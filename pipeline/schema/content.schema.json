{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:paper-fig-deck:content.schema",
  "title": "paper-fig-deck content.json",
  "description": "Per-paper authoring input for pipeline/gen_all.py. Schema version 2.",
  "type": "object",
  "required": [
    "paper",
    "figures"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1",
        "2"
      ]
    },
    "paper": {
      "type": "object",
      "required": [
        "title_zh",
        "journal",
        "authors_short",
        "doi",
        "abstract_zh",
        "conclusion_zh",
        "title_page_img"
      ],
      "properties": {
        "title_zh": {
          "type": "string",
          "minLength": 1
        },
        "title_en": {
          "type": "string"
        },
        "journal": {
          "type": "string",
          "minLength": 1
        },
        "authors_short": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "minLength": 1
        },
        "abstract_zh": {
          "type": "string",
          "minLength": 1
        },
        "abstract_src": {
          "type": "string"
        },
        "conclusion_zh": {
          "type": "string",
          "minLength": 1
        },
        "conclusion_src": {
          "type": "string"
        },
        "methods_zh": {
          "type": "string"
        },
        "methods_src": {
          "type": "string"
        },
        "keywords_en": {
          "type": "string"
        },
        "kicker": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "takeaway_good": {
          "type": "string"
        },
        "if_rebuild": {
          "type": "string"
        },
        "project_prefix": {
          "type": "string"
        },
        "ppt_project": {
          "type": "string"
        },
        "intro_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mainline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "title_page_img": {
          "type": "string",
          "minLength": 1,
          "description": "封面图文件名（projects images/ 内）"
        },
        "title_crop": {
          "type": "object",
          "required": [
            "pdf",
            "page",
            "rect",
            "out"
          ],
          "properties": {
            "pdf": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "rect": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "out": {
              "type": "string",
              "minLength": 1
            },
            "z": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "slides"
            ],
            "properties": {
              "kind": {
                "const": "table"
              },
              "title": {
                "type": "string"
              },
              "arguing": {
                "type": "string"
              },
              "critique": {
                "type": "string"
              },
              "slides": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "reading_point",
                    "table_note",
                    "quote",
                    "quote_ref",
                    "table_rows"
                  ],
                  "properties": {
                    "reading_point": {
                      "type": "string",
                      "minLength": 1
                    },
                    "table_note": {
                      "type": "string",
                      "minLength": 1,
                      "description": "右栏说明文字"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "headers": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 6,
                      "items": {
                        "type": "string"
                      }
                    },
                    "table_rows": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 7,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": [
              "num",
              "slides"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "figure",
                  "scheme",
                  "table"
                ]
              },
              "num": {
                "type": "integer",
                "minimum": 1
              },
              "img": {
                "type": "string",
                "minLength": 1
              },
              "arguing": {
                "type": "string"
              },
              "critique": {
                "type": "string"
              },
              "slides": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "reading_point",
                    "what",
                    "body",
                    "quote",
                    "quote_ref"
                  ],
                  "properties": {
                    "reading_point": {
                      "type": "string",
                      "minLength": 1,
                      "description": "读点题名（右面板标题）"
                    },
                    "what": {
                      "type": "string",
                      "minLength": 1,
                      "description": "一句读图指令"
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "description": "正文段落（自动拆续页）"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "description": "原文引用（单行，超长截断）"
                    },
                    "quote_ref": {
                      "type": "string",
                      "minLength": 1,
                      "description": "页码/章节标注"
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
